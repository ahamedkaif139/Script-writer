{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "script-writer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "script_writer_db",
      "database_id": "e7e5f6d4-381d-45fe-b299-1eb5093a8cdd"
    }
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
